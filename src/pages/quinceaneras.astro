---
import AvanaLayout from '../layouts/AvanaLayout.astro';
import { keyServices, venueConfig, ballrooms } from '../data/venue-data';
import FaqSection from '../components/FaqSection.astro';
import CallToActionBanner from '../components/CallToActionBanner.astro';

const service = keyServices.find(s => s.slug === 'quinceaneras')!;
---

<AvanaLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={service.image}
>
  <!-- Quinceañera Hero -->
  <section class="service-hero-section">
    <div class="container text-center">
      <span class="eyebrow">QUINCEAÑERA BANQUET HALL IN BURBANK</span>
      <h1 class="service-hero-title">{service.heroHeadline}</h1>
      <p class="service-hero-subtitle mx-auto">
        Celebrate her transition into young womanhood with the majesty, sparkle, and elegance she deserves. Featuring grand staircase entrances, royal thrones, and unforgettable waltz dance floors.
      </p>

      <div class="service-hero-cta">
        <a href="#availability-modal" class="btn btn-gold open-modal-trigger">
          Check Quinceañera Availability
        </a>
        <a href={`tel:${venueConfig.phoneRaw}`} class="btn btn-outline-white">
          Call: {venueConfig.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Details & Quince Highlights -->
  <section class="section-padding bg-light">
    <div class="container">
      <div class="details-split">
        <div class="details-content">
          <span class="eyebrow">A ROYAL 15TH BIRTHDAY GALA</span>
          <h2 class="section-title">The Perfect Stage for Her Dream Quinceañera</h2>
          <p class="details-text">
            Planning a Quinceañera in Burbank requires a venue that understands the rich traditions of the celebration — from the entrance of the Court of Honor and the changing of the shoes, to the emotional father-daughter waltz and the high-energy dance party.
          </p>
          <p class="details-text">
            Our Burbank ballrooms feature custom color-coordinated LED lighting to match her dress theme, luxury chiavari chairs, royal head table staging, and full catering options including authentic Hispanic and contemporary menus.
          </p>

          <div class="wedding-perks-grid">
            {service.highlights.map(h => (
              <div class="perk-box">
                <span class="perk-check">✦</span>
                <span class="perk-name">{h}</span>
              </div>
            ))}
          </div>

          <div class="mt-4">
            <a href="#availability-modal" class="btn btn-primary open-modal-trigger">
              Book a Free Private Tour for Your Family
            </a>
          </div>
        </div>

        <div class="details-image-card">
          <img src={service.image} alt="Burbank Quinceañera Celebration Setup" class="details-img" />
          <div class="details-badge">
            <span class="badge-title">Royal Quinceañera Packages</span>
            <span class="badge-sub">Grand White Ballroom (Up to 340 Guests)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
  <CallToActionBanner />
</AvanaLayout>

<style>
  .service-hero-section {
    background: linear-gradient(180deg, rgba(32, 31, 29, 0.92) 0%, rgba(24, 22, 18, 0.95) 100%),
                url('/images/venue/burbank-hall-stage-screen-6.jpg') center/cover;
    padding: clamp(5rem, 9vw, 8rem) 1.5rem;
    color: #ffffff;
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .mt-4 { margin-top: 2rem; }

  .service-hero-title {
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    color: #ffffff;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    font-weight: 400;
  }

  .service-hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: rgba(245, 240, 231, 0.85);
    max-width: 720px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .service-hero-cta {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .details-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .details-text {
    font-size: 1rem;
    color: var(--color-text-body);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .wedding-perks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }

  .perk-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg-linen-light);
    border: 1px solid var(--color-border);
  }

  .perk-check {
    color: var(--color-gold);
    font-weight: bold;
  }

  .perk-name {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    font-weight: 500;
  }

  .details-image-card {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .details-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
  }

  .details-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    background: rgba(32, 31, 29, 0.9);
    backdrop-filter: blur(4px);
    padding: 1.25rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .badge-title {
    font-family: var(--font-accent);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .badge-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 968px) {
    .details-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .wedding-perks-grid {
      grid-template-columns: 1fr;
    }
    .service-hero-cta {
      flex-direction: column;
    }
    .service-hero-cta .btn {
      width: 100%;
    }
  }
</style>
