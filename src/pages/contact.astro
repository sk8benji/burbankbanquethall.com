---
import AvanaLayout from '../layouts/AvanaLayout.astro';
import { venueConfig } from '../data/venue-data';
import FaqSection from '../components/FaqSection.astro';
---

<AvanaLayout
  title="Contact Us & Location | Burbank Banquet Hall"
  description="Contact Burbank Banquet Hall to schedule a private walkthrough tour or inquire about weddings, quinceañeras, birthdays, and corporate events in Burbank, CA."
>
  <section class="contact-hero">
    <div class="container text-center">
      <span class="eyebrow">GET IN TOUCH</span>
      <h1 class="contact-title">Contact Burbank Banquet Hall</h1>
      <p class="contact-subtitle mx-auto">
        We would love to welcome you into our ballrooms. Reach out to schedule a private walkthrough, discuss date availability, or review customized catering menus.
      </p>
    </div>
  </section>

  <section class="section-padding bg-light">
    <div class="container">
      <div class="contact-split">
        <!-- Left: Direct Info Card -->
        <div class="contact-card">
          <span class="card-eyebrow">LOCATION & DETAILS</span>
          <h2>Visit Our Burbank Venue</h2>
          <p class="mb-4">
            Conveniently situated in Burbank, CA, accessible via Interstate 5 and CA-134 with dedicated on-site parking for all your guests.
          </p>

          <div class="info-items-list">
            <div class="info-item">
              <span class="info-icon">📍</span>
              <div>
                <strong>Address</strong>
                <p>{venueConfig.address.street}, {venueConfig.address.city}, {venueConfig.address.state} {venueConfig.address.zip}</p>
              </div>
            </div>

            <div class="info-item">
              <span class="info-icon">📞</span>
              <div>
                <strong>Phone (Call or Text)</strong>
                <p><a href={`tel:${venueConfig.phoneRaw}`}>{venueConfig.phone}</a></p>
              </div>
            </div>

            <div class="info-item">
              <span class="info-icon">✉️</span>
              <div>
                <strong>Email</strong>
                <p><a href={`mailto:${venueConfig.email}`}>{venueConfig.email}</a></p>
              </div>
            </div>

            <div class="info-item">
              <span class="info-icon">🕒</span>
              <div>
                <strong>Hours of Operation</strong>
                <p>{venueConfig.operatingHours}</p>
              </div>
            </div>
          </div>

          <div class="tour-highlight-box mt-4">
            <h4>Complimentary Private Walkthrough</h4>
            <p>Tours are offered 7 days a week by appointment with our head event designer. No commitment required.</p>
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="form-wrapper">
          <form class="contact-page-form" id="contact-page-form">
            <span class="eyebrow">SEND A MESSAGE</span>
            <h3 class="form-heading">Request Information</h3>

            <div class="form-group">
              <label for="c-name">Full Name *</label>
              <input type="text" id="c-name" name="name" required placeholder="Your name" />
            </div>

            <div class="form-group">
              <label for="c-phone">Phone Number *</label>
              <input type="tel" id="c-phone" name="phone" required placeholder="(818) 000-0000" />
            </div>

            <div class="form-group">
              <label for="c-email">Email Address *</label>
              <input type="email" id="c-email" name="email" required placeholder="name@email.com" />
            </div>

            <div class="form-group">
              <label for="c-type">Type of Event</label>
              <select id="c-type" name="type">
                <option value="Wedding">Wedding in Burbank</option>
                <option value="Quinceañera">Quinceañera</option>
                <option value="Birthday">Birthday Party</option>
                <option value="Sweet 16">Sweet 16</option>
                <option value="Corporate">Corporate Gala</option>
                <option value="Other">Other Private Event</option>
              </select>
            </div>

            <div class="form-group">
              <label for="c-message">How Can We Help?</label>
              <textarea id="c-message" name="message" rows="4" placeholder="Tell us your desired dates, questions, or ideas..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">
              Send Message
            </button>
          </form>

          <div class="contact-success" id="contact-success" style="display: none;">
            <div class="success-icon">✓</div>
            <h3>Thank You!</h3>
            <p>Your message has been sent to our Burbank event team. We will get back to you shortly.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
</AvanaLayout>

<style>
  .contact-hero {
    background-color: var(--color-bg-linen);
    padding: clamp(4rem, 7vw, 6rem) 1.5rem 3rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .w-100 { width: 100%; text-align: center; }
  .mb-4 { margin-bottom: 1.5rem; }
  .mt-4 { margin-top: 1.5rem; }

  .contact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    color: var(--color-text-dark);
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .contact-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-body);
    max-width: 680px;
    line-height: 1.65;
  }

  .contact-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .contact-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 3vw, 3rem);
  }

  .card-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .contact-card h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-icon {
    font-size: 1.25rem;
  }

  .info-item strong {
    font-family: var(--font-accent);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.2rem;
  }

  .info-item p {
    font-size: 0.95rem;
    color: var(--color-text-dark);
  }

  .info-item a:hover {
    color: var(--color-gold);
  }

  .tour-highlight-box {
    background: var(--color-bg-linen-light);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    padding: 1.25rem;
  }

  .tour-highlight-box h4 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .tour-highlight-box p {
    font-size: 0.85rem;
    color: var(--color-text-body);
  }

  /* Form */
  .form-wrapper {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 3vw, 3rem);
  }

  .contact-page-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-heading {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-linen-light);
    font-family: inherit;
    font-size: 0.95rem;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    background: #ffffff;
  }

  .contact-success {
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .success-icon {
    width: 60px;
    height: 60px;
    background: var(--color-gold);
    color: #ffffff;
    font-size: 2rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .contact-split {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactPage() {
    const form = document.getElementById('contact-page-form') as HTMLFormElement;
    const success = document.getElementById('contact-success');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        eventType: formData.get('type'),
        notes: formData.get('message')
      };

      try {
        await fetch('/.netlify/functions/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        console.error('Error submitting contact form:', err);
      }

      form.style.display = 'none';
      if (success) success.style.display = 'block';
    });
  }

  document.addEventListener('DOMContentLoaded', initContactPage);
</script>
