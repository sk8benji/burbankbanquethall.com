---
import AvanaLayout from '../layouts/AvanaLayout.astro';
import { keyServices, venueConfig, ballrooms } from '../data/venue-data';
import FaqSection from '../components/FaqSection.astro';
import CallToActionBanner from '../components/CallToActionBanner.astro';

const service = keyServices.find(s => s.slug === 'weddings')!;
---

<AvanaLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={service.image}
>
  <!-- Service Hero -->
  <section class="service-hero-section">
    <div class="container text-center">
      <span class="eyebrow">WEDDING VENUE IN BURBANK</span>
      <h1 class="service-hero-title">{service.heroHeadline}</h1>
      <p class="service-hero-subtitle mx-auto">
        Say "I do" in an atmosphere of timeless romance and grandeur. From crystal chandeliers and custom floral staging to multi-course banquets crafted by our master chefs.
      </p>

      <div class="service-hero-cta">
        <a href="#availability-modal" class="btn btn-gold open-modal-trigger">
          Check Wedding Date Availability
        </a>
        <a href={`tel:${venueConfig.phoneRaw}`} class="btn btn-outline-white">
          Call: {venueConfig.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Service Details & Highlights -->
  <section class="section-padding bg-light">
    <div class="container">
      <div class="details-split">
        <div class="details-content">
          <span class="eyebrow">UNMATCHED WEDDING LUXURY</span>
          <h2 class="section-title">A Wedding Celebration Designed for Royalty</h2>
          <p class="details-text">
            At Burbank Banquet Hall, we understand that your wedding day is a once-in-a-lifetime milestone. Our dedicated team of event stylists and coordinators ensures every nuance is flawlessly executed.
          </p>
          <p class="details-text">
            Whether you envision a grand celebration for up to 340 guests in The Grand White Ballroom or an intimate romantic gathering in The Modern Ballroom, our Burbank wedding packages cover every detail under one roof.
          </p>

          <div class="wedding-perks-grid">
            {service.highlights.map(h => (
              <div class="perk-box">
                <span class="perk-check">✦</span>
                <span class="perk-name">{h}</span>
              </div>
            ))}
          </div>

          <div class="mt-4">
            <a href="#availability-modal" class="btn btn-primary open-modal-trigger">
              Schedule Your Private Walkthrough
            </a>
          </div>
        </div>

        <div class="details-image-card">
          <img src={service.image} alt="Burbank Banquet Hall Wedding Setup" class="details-img" />
          <div class="details-badge">
            <span class="badge-title">WeddingWire Couples' Choice</span>
            <span class="badge-sub">Top Rated in Burbank & Los Angeles</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Suitable Ballrooms -->
  <section class="section-padding bg-linen">
    <div class="container text-center">
      <span class="eyebrow">CHOOSE YOUR SPACE</span>
      <h2 class="section-title">Ballrooms Ideal for Weddings in Burbank</h2>
      
      <div class="wedding-ballrooms-grid mt-4">
        {ballrooms.slice(0, 2).map(b => (
          <div class="ballroom-wedding-card">
            <img src={b.image} alt={b.name} />
            <div class="b-wedding-body">
              <h3>{b.name}</h3>
              <p>{b.subtitle}</p>
              <div class="b-wedding-specs">
                <span><strong>Capacity:</strong> {b.capacity}</span>
                <span><strong>Style:</strong> {b.style}</span>
              </div>
              <a href="#availability-modal" class="btn btn-outline w-100 open-modal-trigger">
                Check Availability for {b.name}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqSection />
  <CallToActionBanner />
</AvanaLayout>

<style>
  .service-hero-section {
    background: linear-gradient(180deg, rgba(32, 31, 29, 0.92) 0%, rgba(24, 22, 18, 0.95) 100%),
                url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1600&q=80') center/cover;
    padding: clamp(5rem, 9vw, 8rem) 1.5rem;
    color: #ffffff;
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .mt-4 { margin-top: 2rem; }
  .w-100 { width: 100%; text-align: center; }

  .service-hero-title {
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    color: #ffffff;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    font-weight: 400;
  }

  .service-hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: rgba(245, 240, 231, 0.85);
    max-width: 720px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .service-hero-cta {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Details Split */
  .details-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .details-text {
    font-size: 1rem;
    color: var(--color-text-body);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .wedding-perks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }

  .perk-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg-linen-light);
    border: 1px solid var(--color-border);
  }

  .perk-check {
    color: var(--color-gold);
    font-weight: bold;
  }

  .perk-name {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    font-weight: 500;
  }

  .details-image-card {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .details-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
  }

  .details-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    background: rgba(32, 31, 29, 0.9);
    backdrop-filter: blur(4px);
    padding: 1.25rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .badge-title {
    font-family: var(--font-accent);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .badge-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Ballrooms Grid */
  .wedding-ballrooms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
  }

  .ballroom-wedding-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .ballroom-wedding-card img {
    height: 220px;
    width: 100%;
    object-fit: cover;
  }

  .b-wedding-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .b-wedding-body h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .b-wedding-body p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .b-wedding-specs {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 968px) {
    .details-split {
      grid-template-columns: 1fr;
    }
    .wedding-ballrooms-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .wedding-perks-grid {
      grid-template-columns: 1fr;
    }
    .service-hero-cta {
      flex-direction: column;
    }
    .service-hero-cta .btn {
      width: 100%;
    }
  }
</style>
