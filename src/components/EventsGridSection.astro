---
import { keyServices, allEventTypes, venueConfig } from '../data/venue-data';
---

<section class="events-section section-padding bg-linen" id="events">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow">EVENTS WE HOST</span>
      <h2 class="section-title">Every Occasion Deserves Burbank Banquet Hall</h2>
      <p class="section-subtitle mx-auto">
        Burbank Banquet Hall offers a versatile, luxurious space that can accommodate a wide range of milestone celebrations — from royal weddings and quinceañeras to intimate christenings and corporate galas in Burbank, Los Angeles.
      </p>
    </div>

    <!-- Featured Top 4 Event Services (With Dedicated Pages) -->
    <div class="featured-services-grid">
      {keyServices.map((service) => (
        <article class="service-card">
          <div class="service-img-wrap">
            <img src={service.image} alt={service.title} loading="lazy" />
            <span class="service-badge">{service.capacity}</span>
          </div>
          <div class="service-body">
            <h3 class="service-title">{service.title}</h3>
            <p class="service-desc">{service.shortDesc}</p>
            <ul class="service-highlights">
              {service.highlights.slice(0, 3).map((h) => (
                <li>
                  <span class="bullet">✦</span> {h}
                </li>
              ))}
            </ul>
            <div class="service-actions">
              <a href={`/${service.slug}`} class="service-link">
                <span>View Details & Packages</span>
                <span class="arrow">→</span>
              </a>
              <a href="#availability-modal" class="btn btn-outline service-cta open-modal-trigger">
                Check Date
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- 11+ Event Types Interactive Pill Tags -->
    <div class="all-events-box">
      <span class="box-label">ADDITIONAL CELEBRATIONS WE HOST IN BURBANK:</span>
      <div class="pills-container">
        {allEventTypes.map((event) => (
          <span class="event-pill">
            {event.name}
          </span>
        ))}
      </div>
      <div class="all-events-footer">
        <a href="#availability-modal" class="btn btn-primary open-modal-trigger">
          <span>Check Pricing & Availability</span>
        </a>
        <a href={`tel:${venueConfig.phoneRaw}`} class="call-banner-link">
          <span class="icon">📞</span>
          <span>Call or Text: {venueConfig.phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .events-section {
    background-color: var(--color-bg-linen);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header {
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  /* 4 Main Services Grid */
  .featured-services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .service-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .service-img-wrap {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .service-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .service-card:hover .service-img-wrap img {
    transform: scale(1.06);
  }

  .service-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(32, 31, 29, 0.85);
    color: #ffffff;
    font-family: var(--font-accent);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    backdrop-filter: blur(4px);
  }

  .service-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .service-title {
    font-size: 1.25rem;
    color: var(--color-text-dark);
    margin-bottom: 0.6rem;
    font-weight: 600;
  }

  .service-desc {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .service-highlights {
    list-style: none;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .service-highlights li {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bullet {
    color: var(--color-gold);
    font-size: 0.65rem;
  }

  .service-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dark);
    padding: 0.4rem 0;
  }

  .service-link:hover {
    color: var(--color-gold);
  }

  .service-cta {
    font-size: 0.75rem;
    padding: 0.6rem 1rem;
    width: 100%;
    text-align: center;
  }

  /* All Events Pill Box */
  .all-events-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .box-label {
    font-family: var(--font-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-dark);
    display: block;
    margin-bottom: 1.5rem;
  }

  .pills-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }

  .event-pill {
    padding: 0.5rem 1rem;
    background: var(--color-bg-linen-light);
    border: 1px solid var(--color-border);
    font-family: var(--font-accent);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-dark);
    letter-spacing: 0.04em;
    transition: all 0.25s ease;
  }

  .event-pill:hover {
    background: var(--color-gold);
    color: #ffffff;
    border-color: var(--color-gold);
  }

  .all-events-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .call-banner-link {
    font-family: var(--font-accent);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-dark);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .call-banner-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 1200px) {
    .featured-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .featured-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
