---
import { venueConfig } from '../data/venue-data';
---

<section class="hero-showcase-section">
  <div class="container">
    <div class="hero-layout">
      <!-- Left Content Column -->
      <div class="hero-content">
        <div class="hero-trust-badge">
          <div class="stars">★★★★★</div>
          <span class="badge-text">{venueConfig.ratings.score}★ Top-Rated Venue in Burbank · {venueConfig.ratings.reviewCount} Google Reviews</span>
        </div>

        <h1 class="hero-h1">
          The Premier <span class="text-gold">Banquet Hall</span> in Burbank, CA
        </h1>

        <p class="hero-description">
          Host your wedding, quinceañera, milestone birthday, or private event at Burbank's most sought-after banquet venue. Featuring two magnificent ballrooms, an open-air sky lounge, award-winning in-house catering, and personal coordination under one roof.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions">
          <a href="#availability-modal" class="btn btn-primary open-modal-trigger">
            <span>Check Availability & Pricing</span>
          </a>
          <a href={`tel:${venueConfig.phoneRaw}`} class="btn btn-outline">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{venueConfig.phone}</span>
          </a>
        </div>

        <!-- Venue Highlights Pill List -->
        <div class="hero-pills">
          <div class="pill-item">
            <span class="pill-dot">✦</span>
            <span>Capacity up to 340</span>
          </div>
          <div class="pill-item">
            <span class="pill-dot">✦</span>
            <span>2 Ballrooms + Sky Lounge</span>
          </div>
          <div class="pill-item">
            <span class="pill-dot">✦</span>
            <span>All-Inclusive Décor</span>
          </div>
          <div class="pill-item">
            <span class="pill-dot">✦</span>
            <span>Zero-Obligation Tour</span>
          </div>
        </div>
      </div>

      <!-- Right Visual Column: Masonry Grid of Ballrooms & Events -->
      <div class="hero-visual-grid">
        <div class="grid-col main-col">
          <div class="grid-card card-large">
            <img 
              src="/images/venue/burbank-hall-dancefloor-1.jpg" 
              alt="The Grand White Ballroom at Burbank Banquet Hall"
              loading="eager"
            />
            <div class="card-caption">
              <span class="caption-tag">GRAND WHITE BALLROOM</span>
              <span class="caption-sub">Up to 340 Guests</span>
            </div>
          </div>
        </div>
        <div class="grid-col side-col">
          <div class="grid-card card-small">
            <img 
              src="/images/venue/burbank-hall-interior-setup-5.jpg" 
              alt="Modern Ballroom in Burbank"
              loading="eager"
            />
            <div class="card-caption">
              <span class="caption-tag">THE MODERN BALLROOM</span>
              <span class="caption-sub">Intimate Celebrations</span>
            </div>
          </div>
          <div class="grid-card card-small">
            <img 
              src="/images/venue/burbank-hall-wedding-stage-2.jpg" 
              alt="Luxury Wedding banquet in Burbank"
              loading="eager"
            />
            <div class="card-caption">
              <span class="caption-tag">WEDDING & EVENT STAGING</span>
              <span class="caption-sub">Bespoke Celebrations</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-showcase-section {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-linen-light) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  /* Content Column */
  .hero-trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 40px;
    margin-bottom: 1.25rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .stars {
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .badge-text {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-dark);
    letter-spacing: 0.04em;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4vw, 3.65rem);
    line-height: 1.15;
    font-weight: 400;
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .text-gold {
    color: var(--color-gold);
    font-weight: 500;
    font-style: italic;
    font-family: var(--font-editorial);
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.65;
    color: var(--color-text-body);
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .hero-pills {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .pill-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .pill-dot {
    color: var(--color-gold);
    font-size: 0.65rem;
  }

  /* Right Visual Column */
  .hero-visual-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1rem;
    height: 520px;
  }

  .grid-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .grid-card {
    position: relative;
    overflow: hidden;
    background-color: #201f1d;
  }

  .card-large {
    height: 100%;
  }

  .card-small {
    height: 50%;
  }

  .grid-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-card:hover img {
    transform: scale(1.04);
  }

  .card-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1.25rem;
    background: linear-gradient(180deg, transparent 0%, rgba(24, 22, 18, 0.85) 100%);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .caption-tag {
    font-family: var(--font-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #ffffff;
    text-transform: uppercase;
  }

  .caption-sub {
    font-size: 0.75rem;
    color: var(--color-gold);
  }

  @media (max-width: 968px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
    .hero-visual-grid {
      height: 420px;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
      text-align: center;
    }
    .hero-visual-grid {
      grid-template-columns: 1fr;
      height: auto;
    }
    .card-large {
      height: 280px;
    }
    .side-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      height: 160px;
    }
    .card-small {
      height: 100%;
    }
  }
</style>
