---
import { venueConfig } from '../data/venue-data';

const venueImages = [
  {
    url: "/images/venue/burbank-hall-stage-screen-6.jpg",
    alt: "The Grand Stage with Crystal Chandeliers & Screen at Burbank Banquet Hall"
  },
  {
    url: "/images/venue/burbank-hall-modern-ballroom-12.jpg",
    alt: "Stunning Ballroom Stage with Blue LED Lighting and Dance Floor"
  },
  {
    url: "/images/venue/burbank-hall-interior-setup-5.jpg",
    alt: "Formal Banquet Tables and Ceiling Architecture at Burbank Banquet Hall"
  }
];
---

<section class="ballrooms-section section-padding" id="ballrooms">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header text-center">
      <span class="eyebrow">OUR VENUE</span>
      <h2 class="section-title">Stunning Ballroom in Burbank</h2>
      <p class="section-subtitle mx-auto">
        Whether you're planning an intimate celebration or a grand royal gala, choose from our beautifully designed space — crafted to make your Burbank celebration truly unforgettable.
      </p>
    </div>

    <!-- Venue Showcase Card -->
    <div class="venue-showcase-card">
      <!-- 3 Images Grid -->
      <div class="venue-images-grid">
        {venueImages.map((img) => (
          <div class="venue-img-wrap">
            <img src={img.url} alt={img.alt} loading="lazy" />
          </div>
        ))}
      </div>

      <!-- Content Below the 3 Images -->
      <div class="venue-card-body">
        <h3 class="venue-showcase-title">Unforgettable Celebrations in Burbank</h3>
        <p class="venue-desc">
          From elegant crystal accents and immersive lighting to exclusive in-house catering and personalized service—every detail is curated to deliver a one-of-a-kind sensory experience, crafted for memories that last a lifetime.
        </p>

        <!-- Specs Grid -->
        <div class="venue-specs">
          <div class="spec-row">
            <span class="spec-label">Capacity</span>
            <span class="spec-value">From 150 to 250 Guests</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Style</span>
            <span class="spec-value">Elegant</span>
          </div>
          <div class="spec-row spec-best-for-row">
            <span class="spec-label">Best for</span>
            <span class="spec-value spec-best-for">
              Weddings, Quinceañeras, Sweet Sixteen, Birthday Parties, Ceremonies, Cocktail Hours, Engagement Parties, and more
            </span>
          </div>
        </div>

        <!-- Button -->
        <div class="venue-cta-wrap text-center">
          <a 
            href="#availability-modal" 
            class="btn btn-primary open-modal-trigger"
            data-ballroom="Burbank Banquet Hall"
          >
            <span>Check Availability</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Location Banner Serving Burbank & LA -->
    <div class="service-area-banner">
      <div class="banner-inner">
        <span class="banner-tag">BURBANK · SAN FERNANDO VALLEY · LOS ANGELES</span>
        <h3 class="banner-title">A Premier Banquet Hall Serving All of Greater Los Angeles</h3>
        <p class="banner-text">
          Located on San Fernando Blvd in Burbank, our venue is conveniently situated for guests arriving from Glendale, North Hollywood, Pasadena, Studio City, Sherman Oaks, and throughout the Valley via I-5 and CA-134.
        </p>
        <div class="banner-actions">
          <a href="#availability-modal" class="btn btn-gold open-modal-trigger">
            Request Date Availability & Pricing
          </a>
          <a href={`tel:${venueConfig.phoneRaw}`} class="btn btn-outline-white">
            Call: {venueConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ballrooms-section {
    background-color: var(--color-bg-light);
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header {
    margin-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  /* Venue Showcase Card */
  .venue-showcase-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    margin-bottom: 4.5rem;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .venue-images-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: 1.25rem 1.25rem 0 1.25rem;
  }

  .venue-img-wrap {
    position: relative;
    height: 280px;
    overflow: hidden;
    background-color: #201f1d;
  }

  .venue-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .venue-img-wrap:hover img {
    transform: scale(1.05);
  }

  /* Venue Card Body */
  .venue-card-body {
    padding: 2.75rem clamp(1.5rem, 4vw, 3.5rem);
  }

  .venue-showcase-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 500;
    color: var(--color-text-dark);
    text-align: center;
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
  }

  .venue-desc {
    font-size: 1.1rem;
    color: var(--color-text-body);
    line-height: 1.75;
    text-align: center;
    max-width: 900px;
    margin: 0 auto 2.25rem auto;
  }

  .venue-specs {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
    margin-bottom: 2.25rem;
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    gap: 2rem;
    align-items: start;
  }

  .spec-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .spec-label {
    font-family: var(--font-accent);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .spec-value {
    color: var(--color-text-dark);
    font-weight: 600;
    font-size: 1rem;
  }

  .spec-best-for {
    color: var(--color-gold);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .venue-cta-wrap {
    margin-top: 0.5rem;
  }

  .venue-cta-wrap .btn {
    padding: 0.95rem 3rem;
    font-size: 0.875rem;
  }

  /* Service Area Banner */
  .service-area-banner {
    background: #201f1d;
    color: var(--color-text-light);
    padding: clamp(2.5rem, 4vw, 3.5rem) 2.5rem;
    text-align: center;
    border-left: 3px solid var(--color-gold);
  }

  .banner-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .banner-tag {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: #ffffff;
    font-weight: 400;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .banner-text {
    font-size: 1rem;
    color: rgba(245, 240, 231, 0.85);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .banner-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .venue-images-grid {
      grid-template-columns: 1fr;
    }
    .venue-img-wrap {
      height: 220px;
    }
    .venue-specs {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
