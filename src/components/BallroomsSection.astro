---
import { ballrooms, venueConfig } from '../data/venue-data';
---

<section class="ballrooms-section section-padding" id="ballrooms">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header text-center">
      <span class="eyebrow">OUR SPACES</span>
      <h2 class="section-title">Two Stunning Ballrooms in Burbank</h2>
      <p class="section-subtitle mx-auto">
        Whether you're planning an intimate celebration or a grand royal gala, choose from our beautifully designed spaces — each crafted to make your Burbank celebration truly unforgettable.
      </p>
    </div>

    <!-- Ballrooms Grid -->
    <div class="ballrooms-grid">
      {ballrooms.map((ballroom) => (
        <article class={`ballroom-card ${ballroom.isUpcoming ? 'is-upcoming' : ''}`}>
          <div class="card-image-wrap">
            <img src={ballroom.image} alt={ballroom.name} loading="lazy" />
            <span class="card-tag">{ballroom.tag}</span>
          </div>

          <div class="card-body">
            <h3 class="ballroom-title">{ballroom.name}</h3>
            <p class="ballroom-desc">{ballroom.description}</p>

            <!-- Specs Grid -->
            <div class="ballroom-specs">
              <div class="spec-row">
                <span class="spec-label">Capacity</span>
                <span class="spec-value">{ballroom.capacity}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Style</span>
                <span class="spec-value">{ballroom.style}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Best for</span>
                <span class="spec-value spec-best-for">
                  {ballroom.bestFor.slice(0, 3).join(', ')}
                </span>
              </div>
            </div>

            <!-- Features Bullet List -->
            <ul class="features-list">
              {ballroom.features.map((feature) => (
                <li class="feature-item">
                  <span class="check-icon">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <!-- CTA -->
            <div class="card-footer">
              <a 
                href="#availability-modal" 
                class={`btn ${ballroom.isUpcoming ? 'btn-outline' : 'btn-primary'} w-100 open-modal-trigger`}
                data-ballroom={ballroom.name}
              >
                <span>{ballroom.ctaText}</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Location Banner Serving Burbank & LA -->
    <div class="service-area-banner">
      <div class="banner-inner">
        <span class="banner-tag">BURBANK · SAN FERNANDO VALLEY · LOS ANGELES</span>
        <h3 class="banner-title">A Premier Banquet Hall Serving All of Greater Los Angeles</h3>
        <p class="banner-text">
          Located on San Fernando Blvd in Burbank, our venue is conveniently situated for guests arriving from Glendale, North Hollywood, Pasadena, Studio City, Sherman Oaks, and throughout the Valley via I-5 and CA-134.
        </p>
        <div class="banner-actions">
          <a href="#availability-modal" class="btn btn-gold open-modal-trigger">
            Request Date Availability & Pricing
          </a>
          <a href={`tel:${venueConfig.phoneRaw}`} class="btn btn-outline-white">
            Call: {venueConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ballrooms-section {
    background-color: var(--color-bg-light);
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header {
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  /* Ballrooms Grid */
  .ballrooms-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4.5rem;
  }

  .ballroom-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ballroom-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .card-image-wrap {
    position: relative;
    height: 240px;
    overflow: hidden;
    background-color: #201f1d;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ballroom-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-bg-dark);
    color: var(--color-bg-linen);
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
  }

  .is-upcoming .card-tag {
    background-color: var(--color-gold);
    color: #ffffff;
  }

  .card-body {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ballroom-title {
    font-size: 1.5rem;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .ballroom-desc {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 0;
  }

  .ballroom-specs {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  .spec-label {
    font-family: var(--font-accent);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .spec-value {
    color: var(--color-text-dark);
    font-weight: 600;
  }

  .spec-best-for {
    text-align: right;
    max-width: 60%;
    color: var(--color-gold);
  }

  .features-list {
    list-style: none;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .feature-item {
    font-size: 0.85rem;
    color: var(--color-text-body);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .check-icon {
    color: var(--color-gold);
    font-weight: bold;
    font-size: 0.8rem;
  }

  .card-footer {
    margin-top: auto;
  }

  .w-100 {
    width: 100%;
  }

  /* Service Area Banner */
  .service-area-banner {
    background: #201f1d;
    color: var(--color-text-light);
    padding: clamp(2.5rem, 4vw, 3.5rem) 2.5rem;
    text-align: center;
    border-left: 3px solid var(--color-gold);
  }

  .banner-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .banner-tag {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.75rem;
  }

  .banner-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: #ffffff;
    font-weight: 400;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .banner-text {
    font-size: 1rem;
    color: rgba(245, 240, 231, 0.85);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .banner-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .ballrooms-grid {
      grid-template-columns: 1fr;
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
