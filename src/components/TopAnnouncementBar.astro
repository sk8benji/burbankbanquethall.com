---
import { venueConfig } from '../data/venue-data';
---

<div class="avana-announcement-bar">
  <div class="announcement-inner">
    <div class="announcement-contact">
      <a href={`tel:${venueConfig.phoneRaw}`} class="announcement-link">
        <svg class="phone-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>CALL OR TEXT: {venueConfig.phone}</span>
      </a>
      <span class="announcement-separator">✦</span>
      <span class="announcement-promo">BURBANK'S PREMIER WEDDING & EVENT BALLROOMS</span>
      <span class="announcement-separator">✦</span>
      <a href="#availability-modal" class="announcement-action open-modal-trigger">
        <span>BOOK A COMPLIMENTARY PRIVATE TOUR</span>
      </a>
    </div>
  </div>
</div>

<style>
  .avana-announcement-bar {
    background-color: var(--color-bg-dark);
    color: var(--color-bg-linen);
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    min-height: var(--topbar-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 1.5rem;
    position: relative;
    z-index: 40;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .announcement-inner {
    width: 100%;
    max-width: var(--max-width);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .announcement-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .announcement-link, .announcement-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    transition: color 0.2s ease;
  }

  .announcement-link:hover, .announcement-action:hover {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .announcement-separator {
    color: var(--color-gold);
    font-size: 0.65rem;
    opacity: 0.85;
  }

  .phone-icon {
    stroke: var(--color-gold);
  }

  @media (max-width: 900px) {
    .announcement-promo {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .announcement-action {
      display: none;
    }
    .announcement-separator {
      display: none;
    }
  }
</style>
