---
import { venueConfig, keyServices } from '../data/venue-data';
---

<footer class="avana-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Contact -->
      <div class="footer-col brand-col">
        <div class="footer-brand-title">BURBANK BANQUET HALL</div>
        <p class="footer-tagline">
          Burbank's premier luxury wedding and private event venue featuring two elegant ballrooms, open-air sky lounge, and bespoke catering.
        </p>
        <div class="footer-contact-info">
          <p class="contact-line">
            <span class="contact-icon">📍</span>
            <span>{venueConfig.address.street}, {venueConfig.address.city}, {venueConfig.address.state} {venueConfig.address.zip}</span>
          </p>
          <p class="contact-line">
            <span class="contact-icon">📞</span>
            <a href={`tel:${venueConfig.phoneRaw}`}>{venueConfig.phone}</a>
          </p>
          <p class="contact-line">
            <span class="contact-icon">✉️</span>
            <a href={`mailto:${venueConfig.email}`}>{venueConfig.email}</a>
          </p>
          <p class="contact-line">
            <span class="contact-icon">🕒</span>
            <span>{venueConfig.operatingHours}</span>
          </p>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-nav">
          <li><a href="/">Home</a></li>
          <li><a href="/#ballrooms">Our Ballrooms</a></li>
          <li><a href="/#why-us">Why Choose Us</a></li>
          <li><a href="/#reviews">Client Reviews</a></li>
          <li><a href="/#gallery">Photo Gallery</a></li>
          <li><a href="/#faqs">Event FAQs</a></li>
          <li><a href="#availability-modal" class="open-modal-trigger">Pricing & Availability</a></li>
        </ul>
      </div>

      <!-- Col 3: Key Events in Burbank -->
      <div class="footer-col">
        <h3 class="footer-heading">Events in Burbank</h3>
        <ul class="footer-nav">
          <li><a href="/weddings">Weddings in Burbank</a></li>
          <li><a href="/birthday-parties">Birthday Parties in Burbank</a></li>
          <li><a href="/quinceaneras">Quinceañeras in Burbank</a></li>
          <li><a href="/sweet-sixteen">Sweet Sixteen in Burbank</a></li>
          <li><a href="/#events">Christenings & Baptisms</a></li>
          <li><a href="/#events">Corporate Galas & Meetings</a></li>
          <li><a href="/#events">Bar & Bat Mitzvahs</a></li>
          <li><a href="/#events">Film & Studio Shoots</a></li>
        </ul>
      </div>

      <!-- Col 4: Get Started / Hours -->
      <div class="footer-col">
        <h3 class="footer-heading">Get Started</h3>
        <p class="footer-desc">
          Schedule your complimentary private walkthrough with our lead event designer. No obligation.
        </p>
        <a href="#availability-modal" class="btn btn-gold w-100 open-modal-trigger mb-3">
          Book Private Tour
        </a>
        <div class="social-links-box">
          <span class="social-label">Follow Us</span>
          <div class="social-icons">
            <a href="#" class="social-btn" aria-label="Instagram">IG</a>
            <a href="#" class="social-btn" aria-label="Facebook">FB</a>
            <a href="#" class="social-btn" aria-label="Pinterest">PI</a>
            <a href="#" class="social-btn" aria-label="Yelp">YP</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-copy">
        © {new Date().getFullYear()} {venueConfig.name}. All Rights Reserved. Premier Banquet Hall Serving Burbank, Glendale, North Hollywood & Greater Los Angeles.
      </div>
      <div class="bottom-links">
        <a href="#">Privacy Policy</a>
        <span class="sep">|</span>
        <a href="#">Terms of Service</a>
        <span class="sep">|</span>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .avana-footer {
    background-color: var(--color-bg-dark);
    color: var(--color-bg-linen);
    padding-top: clamp(4rem, 6vw, 5.5rem);
    padding-bottom: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-title {
    font-family: var(--font-accent);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: rgba(245, 240, 231, 0.75);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.8125rem;
    color: rgba(245, 240, 231, 0.85);
  }

  .contact-line {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .contact-line a:hover {
    color: var(--color-gold);
  }

  .footer-heading {
    font-family: var(--font-accent);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }

  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    font-size: 0.875rem;
    color: rgba(245, 240, 231, 0.75);
    transition: color 0.25s ease;
  }

  .footer-nav a:hover {
    color: var(--color-gold);
    padding-left: 4px;
  }

  .footer-desc {
    font-size: 0.875rem;
    color: rgba(245, 240, 231, 0.75);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .w-100 {
    width: 100%;
    text-align: center;
  }

  .mb-3 {
    margin-bottom: 1.5rem;
  }

  .social-links-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-label {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .social-icons {
    display: flex;
    gap: 0.65rem;
  }

  .social-btn {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    transition: all 0.25s ease;
  }

  .social-btn:hover {
    border-color: var(--color-gold);
    background-color: var(--color-gold);
    color: #ffffff;
  }

  /* Bottom Bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.75rem;
    color: rgba(245, 240, 231, 0.55);
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bottom-links a:hover {
    color: var(--color-gold);
  }

  .sep {
    opacity: 0.3;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
