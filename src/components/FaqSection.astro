---
import { faqs, venueConfig } from '../data/venue-data';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="faq-section section-padding bg-linen" id="faqs">
  <div class="container">
    <div class="faq-layout">
      <!-- Left Column: Header & Planning Callout Card -->
      <div class="faq-sidebar">
        <span class="eyebrow">EVENT VENUE FAQS</span>
        <h2 class="faq-headline">Burbank Event Venue Questions Answered</h2>
        <p class="faq-intro">
          Answers about our Burbank location, ballroom capacity, weddings, quinceañeras, catering options, pricing packages, and scheduling private tours.
        </p>

        <!-- CTA Callout Box replicating Avana -->
        <div class="faq-callout-card">
          <span class="card-eyebrow">PLANNING AN EVENT?</span>
          <h3 class="card-title">Check Your Date Availability & Pricing</h3>
          <p class="card-text">
            Receive personalized pricing and request a complimentary walkthrough with our Burbank event coordinators.
          </p>
          <a href="#availability-modal" class="btn btn-primary w-100 open-modal-trigger">
            <span>Check Pricing & Availability</span>
          </a>
          <div class="card-phone-wrap">
            <span class="star-icon">✦</span>
            <a href={`tel:${venueConfig.phoneRaw}`} class="card-phone">
              {venueConfig.phone}
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Accordion -->
      <div class="faq-accordion-wrap">
        <div class="accordion-list">
          {faqs.map((faq, index) => (
            <div class="accordion-item" data-index={index}>
              <button 
                class="accordion-trigger" 
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`faq-answer-${index}`}
              >
                <span class="trigger-question">{faq.question}</span>
                <span class="trigger-icon">{index === 0 ? '−' : '+'}</span>
              </button>
              <div 
                class={`accordion-panel ${index === 0 ? 'is-open' : ''}`}
                id={`faq-answer-${index}`}
              >
                <div class="panel-inner">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Injected FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-section {
    background-color: var(--color-bg-linen);
    border-top: 1px solid var(--color-border);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* Left Column */
  .faq-headline {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: var(--color-text-dark);
    margin-bottom: 1.25rem;
    line-height: 1.2;
    font-weight: 400;
  }

  .faq-intro {
    font-size: 1rem;
    color: var(--color-text-body);
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .faq-callout-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-left: 3px solid var(--color-gold);
  }

  .card-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold);
  }

  .card-title {
    font-size: 1.35rem;
    color: var(--color-text-dark);
    line-height: 1.3;
    font-weight: 600;
  }

  .card-text {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.6;
  }

  .w-100 {
    width: 100%;
    text-align: center;
  }

  .card-phone-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .star-icon {
    color: var(--color-gold);
  }

  .card-phone {
    font-family: var(--font-accent);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .card-phone:hover {
    color: var(--color-gold);
  }

  /* Right Accordion */
  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .accordion-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    transition: border-color 0.25s ease;
  }

  .accordion-item:hover {
    border-color: var(--color-gold);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1.75rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 1rem;
  }

  .trigger-question {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.4;
  }

  .trigger-icon {
    font-size: 1.4rem;
    font-family: var(--font-accent);
    color: var(--color-gold);
    flex-shrink: 0;
    font-weight: 600;
  }

  .accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, opacity 0.3s ease;
    opacity: 0;
  }

  .accordion-panel.is-open {
    max-height: 300px;
    opacity: 1;
  }

  .panel-inner {
    padding: 0 1.75rem 1.5rem 1.75rem;
    font-size: 0.95rem;
    color: var(--color-text-body);
    line-height: 1.65;
    border-top: 1px solid var(--color-border-dark);
  }

  @media (max-width: 992px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initAccordion() {
    const items = document.querySelectorAll('.accordion-item');

    items.forEach((item) => {
      const trigger = item.querySelector('.accordion-trigger');
      const panel = item.querySelector('.accordion-panel') as HTMLElement;
      const icon = item.querySelector('.trigger-icon');

      trigger?.addEventListener('click', () => {
        const isOpen = panel?.classList.contains('is-open');

        // Close all
        items.forEach((other) => {
          const otherPanel = other.querySelector('.accordion-panel');
          const otherIcon = other.querySelector('.trigger-icon');
          const otherTrigger = other.querySelector('.accordion-trigger');
          otherPanel?.classList.remove('is-open');
          if (otherIcon) otherIcon.textContent = '+';
          otherTrigger?.setAttribute('aria-expanded', 'false');
        });

        // Toggle clicked
        if (!isOpen) {
          panel?.classList.add('is-open');
          if (icon) icon.textContent = '−';
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initAccordion);
</script>
