# ==========================================
# CONFIGURACIÓN DE CORREO AWS (Amazon SES)
# ==========================================

# 1. Credenciales SMTP de AWS SES (Recomendado):
# En la consola de AWS -> Amazon SES -> SMTP Settings -> "Create SMTP credentials"
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_USER=AKIAXXXXXXXXXXXXXXXX
AWS_SES_PASS=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2. Correos de Envío y Recepción:
# EMAIL_FROM: Debe ser un dominio o email verificado en AWS SES
EMAIL_FROM=info@burbankbanquethall.com
# EMAIL_TO: El correo donde quieres recibir las cotizaciones y leads
EMAIL_TO=events@burbankbanquethall.com

# 3. (Opcional) Si usas AWS Access Keys directamente:
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AWS_REGION=us-east-1
